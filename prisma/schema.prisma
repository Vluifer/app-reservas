// Modelo de persistencia. Las reglas de negocio NO viven aquí sino en src/modules/*/domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String     @id @default(cuid())
  nombre    String
  email     String     @unique
  password  String
  telefono  String?
  rol       RolUsuario @default(CLIENTE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reservas     Reserva[]
  apartamentos Apartamento[]
}

model Apartamento {
  id           String  @id @default(cuid())
  nombre       String
  descripcion  String  @db.Text
  direccion    String
  ciudad       String
  region       String
  codigoPostal String?

  capacidad       Int
  numHabitaciones Int
  numBanos        Int
  metrosCuadrados Float?

  precioPorNoche      Decimal             @db.Decimal(10, 2)
  tarifaLimpieza      Decimal             @default(0) @db.Decimal(10, 2)
  amenidades          String[]            @default([])
  politicaCancelacion PoliticaCancelacion @default(FLEXIBLE)
  estadoApartamento   EstadoApartamento   @default(ACTIVO)

  propietarioId String
  propietario   Usuario   @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  imagenes      Imagen[]
  reservas      Reserva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ciudad, estadoApartamento])
  @@index([precioPorNoche])
  @@index([propietarioId])
}

model Imagen {
  id          String  @id @default(cuid())
  url         String
  publicId    String?
  orden       Int     @default(0)
  esPrincipal Boolean @default(false)

  apartamentoId String
  apartamento   Apartamento @relation(fields: [apartamentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([apartamentoId, orden])
}

model Reserva {
  id            String @id @default(cuid())
  codigoReserva String @unique

  // Estadía [fechaInicio, fechaFin): fechas sin hora
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  numAdultos  Int
  numNinos    Int      @default(0)

  precioNoches   Decimal @db.Decimal(10, 2)
  tarifaLimpieza Decimal @db.Decimal(10, 2)
  tarifaServicio Decimal @db.Decimal(10, 2)
  impuestos      Decimal @db.Decimal(10, 2)
  precioTotal    Decimal @db.Decimal(10, 2)

  estado              EstadoReserva       @default(PENDIENTE)
  politicaCancelacion PoliticaCancelacion
  montoReembolso      Decimal?            @db.Decimal(10, 2)

  // Copia de los datos del cliente al momento de reservar (historial)
  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?
  notasCliente    String? @db.Text

  apartamentoId String
  apartamento   Apartamento @relation(fields: [apartamentoId], references: [id], onDelete: Restrict)
  clienteId     String
  cliente       Usuario     @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiraEn     DateTime?
  confirmadaEn DateTime?
  canceladaEn  DateTime?

  @@index([apartamentoId, fechaInicio, fechaFin])
  @@index([clienteId])
  @@index([estado, expiraEn])
}

enum RolUsuario {
  CLIENTE
  PROPIETARIO
  ADMIN
}

enum EstadoApartamento {
  ACTIVO
  INACTIVO
  MANTENIMIENTO
  ELIMINADO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  EN_CURSO
  COMPLETADA
  CANCELADA
  RECHAZADA
  EXPIRADA
}

enum PoliticaCancelacion {
  FLEXIBLE
  MODERADA
  ESTRICTA
}
