# Copia este archivo como .env y completa los valores.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/reservas_db"
# Base SEPARADA para las pruebas de integración (se borra en cada corrida)
TEST_DATABASE_URL="postgresql://usuario:password@localhost:5432/reservas_test"

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET="cambia-esto"

# Cloudinary (opcional: sin estas variables la app funciona pero no permite subir imágenes)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Protege el endpoint de la tarea programada /api/cron/expirar-reservas
CRON_SECRET="cambia-esto"
